VITE_API_BASE_URL=
# Set your official Telegram contact URL to enable the floating contact shortcut.
VITE_TELEGRAM_URL=

# Server-side Vercel Function secrets. Never prefix these with VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Neon PostgreSQL. Vercel Marketplace injects DATABASE_URL automatically.
DATABASE_URL=

# CRM webhook security (production secrets; never expose in client code).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SETUP_KEY=

# IndexNow: public host-verification key and temporary one-time submit key.
INDEXNOW_KEY=
INDEXNOW_SUBMIT_KEY=

# Telegram Login (OIDC) for optional username verification on the contact form.
# Register the production origin and this exact redirect URI in @BotFather > Login Widget.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_LOGIN_REDIRECT_URI=https://mjlfulfillment.vercel.app/api/telegram-auth

# Better Auth — server-only secrets. Never prefix these with VITE_.
BETTER_AUTH_URL=http://localhost:5173
# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated additional trusted origins (optional; e.g. Vercel Preview deployments)
BETTER_AUTH_TRUSTED_ORIGINS=

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex ID OAuth (optional until configured)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Resend email delivery for passwordless Magic Links
RESEND_API_KEY=
AUTH_FROM_EMAIL=MJL Fulfillment <noreply@example.com>
